{
  "version": 1,

  "provider": {
    "name": "tikhub",
    "base_url": "https://api.tikhub.io",
    "token": "在这里填入你的 TikHub API key",
    "timeout": 120,
    "retry": {
      "max": 3,
      "backoff": [2, 5, 15]
    },
    "rate_limit": {
      "qps": 1
    }
  },

  "schedule": {
    "timezone": "Asia/Shanghai",
    "default_times": ["09:00", "16:00"],
    "catch_up_on_run": true
  },

  "storage": {
    "data_dir": null,
    "keep_raw": true
  },

  "export": {
    "enabled": true,
    "dir": "~/wechat-articles",
    "layout": "by_account",
    "filename": "{date} {title}.md",
    "bold_keywords": true,
    "include_images": false
  },

